# RAWIN 3.0 Environment Configuration
# Copy this file to .env.local and fill in your values.

# 1. MongoDB & GridFS Storage (Required for CMS, Projects, Blog)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# 2. Administrator Authentication (Required for /admin access)
ADMIN_EMAIL="admin@rawin.dev"
ADMIN_PASSWORD="YourSecurePasswordHere"
SESSION_SECRET="generate-a-random-32-byte-secret-for-jwt-signing"

# 3. RAWIN Orbit (Cloudflare Workers AI - Free Tier)
# Obtain these from https://dash.cloudflare.com -> Workers & AI
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Default model: @cf/meta/llama-3.2-3b-instruct
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.2-3b-instruct"
# Optional custom worker proxy URL (leave empty if using direct Cloudflare API)
CLOUDFLARE_AI_ENDPOINT=""

ORBIT_OWNER_VERIFICATION_CODE=""

# 4. Public Site Origin
NEXT_PUBLIC_SITE_URL=https://rawin.space

# Analytics: GitHub contribution calendar (server-only). A fine-grained token with public
# read-only access and no repository permissions. Leave blank to show the "not connected" state.
GITHUB_TOKEN=
